FROM node:24-bookworm-slim@sha256:55fb5f5a527ea2c5c4a95f963e48ef90aa38c7b346054fdc8ee9957a2b55d205 AS builder
WORKDIR /app/frontend
RUN npm install --global pnpm@11.19.0
COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
COPY THIRD_PARTY_NOTICES.md /app/THIRD_PARTY_NOTICES.md
ARG VITE_OFFLINE_STACK=false
ENV VITE_OFFLINE_STACK=$VITE_OFFLINE_STACK VITE_API_BASE_URL=""
RUN pnpm build

FROM nginx:1.27.4-alpine@sha256:4ff102c5d78d254a6f0da062b3cf39eaf07f01eec0927fd21e219d0af8bc0591
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY deployment/demo/nginx.conf /etc/nginx/nginx.conf
USER 101:101
EXPOSE 8080
