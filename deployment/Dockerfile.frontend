FROM node:26-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS builder
WORKDIR /app/frontend
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/pnpm-workspace.yaml ./
# pnpm is fetched from the registry and installed only when its SHA-512 matches. Node 25+ no
# longer bundles Corepack, so this does not depend on it. Keep the version and hash in step with
# `packageManager` in package.json.
ARG PNPM_VERSION=11.19.0
ARG PNPM_SHA512=7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce
# NODE_USE_ENV_PROXY makes fetch honour the HTTPS_PROXY that Docker passes on proxied networks.
RUN NODE_USE_ENV_PROXY=1 node -e "const {createHash}=require('node:crypto'),fs=require('node:fs');fetch('https://registry.npmjs.org/pnpm/-/pnpm-'+process.argv[1]+'.tgz').then(r=>{if(!r.ok)throw new Error(r.status);return r.arrayBuffer()}).then(b=>{const d=Buffer.from(b);if(createHash('sha512').update(d).digest('hex')!==process.argv[2])throw new Error('pnpm checksum mismatch');fs.writeFileSync('/tmp/pnpm.tgz',d)})" "$PNPM_VERSION" "$PNPM_SHA512" \
    && npm install --global /tmp/pnpm.tgz && rm /tmp/pnpm.tgz
RUN pnpm install --frozen-lockfile
COPY frontend/ ./
COPY THIRD_PARTY_NOTICES.md /app/THIRD_PARTY_NOTICES.md
ARG VITE_OFFLINE_STACK=false
ENV VITE_OFFLINE_STACK=$VITE_OFFLINE_STACK VITE_API_BASE_URL=""
RUN pnpm build

FROM nginx:1.30.6-alpine@sha256:0e52bd054126cdc040b1276c0af347aeb02a41b9cfe305d6094767ac30e97949
# Security fixes for Alpine packages often land after the nginx image is published, so pick them
# up at build time. The digest above still pins the base; this upgrades only OS packages.
RUN apk upgrade --no-cache
COPY --from=builder /app/frontend/dist /usr/share/nginx/html
COPY deployment/demo/nginx.conf /etc/nginx/nginx.conf
USER 101:101
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["wget", "--quiet", "--output-document=/dev/null", "http://127.0.0.1:8080/"]
