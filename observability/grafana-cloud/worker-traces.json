{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "panels": [],
      "title": "Delegated work",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "pointSize": 6
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(voice_operation_duration_seconds_bucket{operation=\"delegate_task\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(voice_operation_duration_seconds_bucket{operation=\"delegate_task\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "B"
        }
      ],
      "title": "Worker duration p50 / p95 (delegate_task)",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cancelled"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "orange",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 2,
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "values": [
            "value"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (max_over_time(voice_operation_duration_seconds_count{operation=\"delegate_task\"}[$__range]))",
          "instant": true,
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Delegations by outcome (selected range)",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "description": "Speech interruptions of running work, explicit or semantic task cancellations, and silence-gated result deliveries.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 3,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "orientation": "vertical",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      },
      "targets": [
        {
          "expr": "sum(max_over_time(voice_interruptions_total[$__range]))",
          "instant": true,
          "legendFormat": "Interruptions",
          "refId": "A"
        },
        {
          "expr": "sum(max_over_time(voice_task_cancellations_total[$__range]))",
          "instant": true,
          "legendFormat": "Cancellations",
          "refId": "B"
        },
        {
          "expr": "sum(max_over_time(voice_task_deliveries_total[$__range]))",
          "instant": true,
          "legendFormat": "Deliveries",
          "refId": "C"
        }
      ],
      "title": "Interruptions / cancellations / deliveries",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "targets": [
        {
          "expr": "sum by (reason) (increase(voice_task_cancellations_total[1h]))",
          "interval": "1h",
          "legendFormat": "cancel: {{reason}}",
          "refId": "A"
        },
        {
          "expr": "sum by (outcome) (increase(voice_task_deliveries_total[1h]))",
          "interval": "1h",
          "legendFormat": "delivery: {{outcome}}",
          "refId": "B"
        }
      ],
      "title": "Task cancellations and deliveries by reason",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0,
          "noValue": "Moderation off or no reviews"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "id": 5,
      "targets": [
        {
          "expr": "sum by (origin, action) (increase({__name__=~\"voice_moderation_reviews(_total)?\"}[1h]))",
          "interval": "1h",
          "legendFormat": "{{origin}} · {{action}}",
          "refId": "A"
        }
      ],
      "title": "Moderation reviews (when VOICE_MODERATION is on)",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 101,
      "panels": [],
      "title": "Traces",
      "type": "row"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${traces}"
      },
      "description": "TraceQL metrics over conversation.turn, provider.transcript, provider.connect, provider.failover and delegate_task spans.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "points",
            "pointSize": 6
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "id": 6,
      "targets": [
        {
          "limit": 20,
          "metricsQueryType": "range",
          "query": "{resource.service.name=\"voice-delegate\"} | quantile_over_time(duration, .95) by (name)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Span duration p95 by span name",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${traces}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "suffix: spans/s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "id": 7,
      "targets": [
        {
          "limit": 20,
          "metricsQueryType": "range",
          "query": "{resource.service.name=\"voice-delegate\"} | rate() by (name)",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Span rate by name (spans per second)",
      "type": "timeseries",
      "description": "TraceQL rate(): matching spans per second, by span name."
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${traces}"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "id": 8,
      "targets": [
        {
          "limit": 50,
          "query": "{resource.service.name=\"voice-delegate\"}",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "traces"
        }
      ],
      "title": "Recent traces (click a trace ID to open it)",
      "type": "table"
    },
    {
      "datasource": {
        "type": "tempo",
        "uid": "${traces}"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "id": 9,
      "targets": [
        {
          "limit": 50,
          "query": "{resource.service.name=\"voice-delegate\" && (duration > 5s || status = error) && name != \"conversation.turn\"}",
          "queryType": "traceql",
          "refId": "A",
          "tableType": "spans"
        }
      ],
      "title": "Slow or failed operations (> 5 s or error status)",
      "type": "table"
    }
  ],
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": [
    "voice-delegate"
  ],
  "templating": {
    "list": [
      {
        "hide": 2,
        "name": "ds",
        "options": [],
        "query": "prometheus",
        "type": "datasource"
      },
      {
        "hide": 2,
        "name": "traces",
        "options": [],
        "query": "tempo",
        "type": "datasource"
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "voice-delegate · Worker & traces",
  "uid": "vd-worker-traces",
  "weekStart": ""
}
