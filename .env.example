# Server template: local development, no credentials, optional features off.
# Copy once to root .env; never overwrite existing keys without a private backup.
# Start make be / make fe from the repository root; make invite prints the local code.
# All choices and validation rules: docs/configuration.md.
# VITE_* values belong to the frontend build environment, not this server file.

# Private OpenAI key. Empty allows the free demo/offline tools, not live voice or paid planners.
OPENAI_API_KEY=

# Azure resource HTTPS origin, e.g. https://your-resource.openai.azure.com; empty when unused.
VOICE_AZURE_ENDPOINT=

# Private Azure resource key; required for azure primary or enabled fallback.
VOICE_AZURE_API_KEY=

# Your Azure deployment name; it need not equal the underlying model name.
VOICE_AZURE_DEPLOYMENT=gpt-realtime

# Azure voice name supported by that deployment.
VOICE_AZURE_VOICE=marin

# true enables one Azure recovery attempt; false disables it. Requires Azure settings.
VOICE_FALLBACK_ENABLED=false

# Voice integration: live | realtime | azure. Deprecated alias: VOICE_VOICE_PROVIDER.
VOICE_ADAPTER=live

# OpenAI Realtime model ID; used only by realtime. Example: gpt-realtime.
VOICE_REALTIME_MODEL=gpt-realtime

# OpenAI Live model ID; used only by live. Example: gpt-live-1. Provider/account support applies.
VOICE_MODEL=gpt-live-1

# OpenAI voice name, e.g. marin; supported names depend on the selected model/adapter.
VOICE_VOICE=marin

# true permits explicitly allowed native origins; false for browser-only use.
VOICE_NATIVE_CLIENTS=false

# JSON array of exact frontend origins; no trailing slash. Production requires HTTPS (native exception documented).
VOICE_ALLOWED_ORIGINS=["http://localhost:5173"]

# JSON array of backend hostnames. No testserver in production; separate from frontend origins.
VOICE_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# false locally; true only behind a known ingress with a verified proxy hop count.
VOICE_TRUST_PROXY=false

# Trusted forwarded-address hop count including socket peer: integer 1..32.
VOICE_TRUSTED_PROXY_HOPS=1

# development for local launcher; production activates strict access/origin/host checks. Use these two modes.
VOICE_ENVIRONMENT=development

# true exposes API documentation in production; development already exposes it. Default false.
VOICE_API_DOCS=false

# true opts into browser audio measurements; false leaves them disabled.
VOICE_AUDIO_TIMING=false

# true separates narration interruption from task cancellation; false retains the legacy path.
VOICE_INTENT_CANCELLATION=false

# Maximum independent tasks with intent cancellation: integer 1..2.
VOICE_MAX_INFLIGHT_TASKS=2

# Maximum wait for delivering a completed result: >0 and <=120 seconds.
VOICE_DELIVERY_TIMEOUT_SECONDS=30

# Silence required before pending delivery: 0.3..5 seconds.
VOICE_DELIVERY_SILENCE_SECONDS=0.6

# Short result-delivery preamble, 1..80 characters.
VOICE_DELIVERY_PREAMBLE="About your request"

# true enables paid semantic cancellation; also requires intent cancellation and OpenAI key.
VOICE_DECISIONS_CANCEL=false

# Cancellation probability threshold: 0.5..1; default 0.85 favors preserving wanted work.
VOICE_DECISIONS_THRESHOLD=0.85

# Decisions request deadline: >0 and <=5 seconds; failure does not semantically cancel work.
VOICE_DECISIONS_TIMEOUT_SECONDS=1

# Maximum semantic cancellation classifications per session: 1..300.
VOICE_DECISIONS_MAX_CALLS=60

# Configured input-token estimate rate, USD per million: 0..100; not an invoice.
VOICE_DECISIONS_INPUT_USD_PER_MILLION=0.1

# true makes consent-based server debug recording available; each session still opts in separately.
VOICE_DEBUG_RECORDING=false

# Private server debug directory; no audio files. Use persistent storage intentionally on hosted services.
VOICE_DEBUG_DIRECTORY=.local/debug

# Optional legacy shared access code. make be overrides it only in its child process; prefer named hosted invites.
VOICE_ACCESS_TOKEN=

# JSON map of pseudonymous names to unique random tokens >=32 chars; make be supplies its own local map.
VOICE_INVITE_TOKENS={}

# false for make be; true requires production, named invites and durable quotas.
VOICE_PUBLIC_DEMO=false

# true exposes the configured demo capability; independent of paid model credentials.
VOICE_DEMO_ENABLED=true

# SQLite quota path. Public demo requires durable storage; hosted mount is /app/.local.
VOICE_QUOTA_DATABASE=.local/quotas.sqlite3

# SQLite diagnostic report path. Parent directory must exist and be writable.
VOICE_FEEDBACK_DATABASE=.local/feedback.sqlite3

# Daily session admissions per invitation: integer 1..100.
VOICE_DAILY_SESSIONS_PER_USER=4

# Simultaneous sessions per invitation: integer 1..10.
VOICE_CONCURRENT_SESSIONS_PER_USER=1

# Reserved daily voice seconds per invitation: integer >=1.
VOICE_DAILY_VOICE_SECONDS_PER_USER=1500

# Reserved daily voice seconds across invitations: integer >=1.
VOICE_DAILY_VOICE_SECONDS_GLOBAL=6000

# Total delegation admission budget per session: integer 1..64.
VOICE_MAX_DELEGATIONS_PER_SESSION=8

# true enables optional backend telemetry; false disables export. No conversation text in ordinary telemetry.
VOICE_OTEL_ENABLED=false

# Optional OTLP trace endpoint; empty uses local console tracing when enabled.
VOICE_OTEL_ENDPOINT=

# Optional OTLP metrics endpoint; empty leaves that export disabled.
VOICE_OTEL_METRICS_ENDPOINT=

# Empty for one API process; otherwise 1..16 lowercase letters/digits and public-demo admission required.
VOICE_INSTANCE_ID=

# local = graph in API process; remote = separately started private HTTP service, possibly on the same host.
VOICE_WORKER_EXECUTION=local

# HTTP(S) worker service origin for remote mode; worker:8001 is Docker service DNS, not a local Mac hostname.
VOICE_WORKER_SERVICE_URL=http://worker:8001

# Private shared service bearer token >=32 chars for remote mode; empty with local execution.
VOICE_WORKER_SERVICE_TOKEN=

# Concurrent worker-service jobs: integer 1..32.
VOICE_WORKER_SERVICE_CAPACITY=4

# Retained worker-service job records: integer 32..1024.
VOICE_WORKER_MAX_RECORDS=128

# offline | openai | decisions. offline needs no text-model key; the others incur provider usage.
VOICE_WORKER_MODE=offline

# true adds Tavily web search to worker tools; false disables it. Natural-language use needs a paid planner.
VOICE_WEB_SEARCH=false

# Private Tavily key on the worker host; required when web search is enabled locally.
TAVILY_API_KEY=

# JSON array of at most 20 allowed domain names; [] means no domain filter.
VOICE_WEB_SEARCH_DOMAINS=[]

# Tavily request deadline: >0 and <=5 seconds.
VOICE_WEB_SEARCH_TIMEOUT_SECONDS=3

# Text model, separate from voice. Default gpt-6-luna; Luna Chat Completions uses reasoning_effort=none.
VOICE_WORKER_MODEL=gpt-6-luna

# Outer task execution deadline: >0 and <=120 seconds.
VOICE_DELEGATION_TIMEOUT_SECONDS=15

# Final delegation narration token budget: integer 8..480.
VOICE_DELEGATION_RESULT_TOKENS=120

# Maximum graph steps per task: integer 1..12.
VOICE_WORKER_MAX_STEPS=4

# Maximum API sessions in memory: integer 1..100.
VOICE_MAX_SESSIONS=4

# Absolute session lifetime: >0 and <=3600 seconds.
VOICE_SESSION_TTL_SECONDS=300

# Expiry after browser heartbeat silence: >0 seconds.
VOICE_HEARTBEAT_TIMEOUT_SECONDS=45

# Session connection deadline: >0 seconds.
VOICE_CONNECT_TIMEOUT_SECONDS=20

# Provider close-confirmation wait: >0 seconds.
VOICE_CLOSE_TIMEOUT_SECONDS=5

# Maximum buffered request size: integer 1024..1048576 bytes.
VOICE_MAX_BODY_BYTES=65536

# Optional private evaluation-upload key; never read by normal live requests.
BRAINTRUST_API_KEY=
