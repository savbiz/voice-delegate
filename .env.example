# Server only. Leave the key empty for the no-cost browser demo.
OPENAI_API_KEY=
VOICE_MODEL=gpt-live-1
VOICE_VOICE=marin
VOICE_ALLOWED_ORIGIN=http://localhost:5173
VOICE_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
VOICE_ENVIRONMENT=development
# Required (at least 24 characters) for public deployment. Enter it in the UI.
VOICE_ACCESS_TOKEN=
VOICE_MAX_SESSIONS=4
VOICE_SESSION_TTL_SECONDS=300
VOICE_HEARTBEAT_TIMEOUT_SECONDS=45
VOICE_CONNECT_TIMEOUT_SECONDS=20
VOICE_CLOSE_TIMEOUT_SECONDS=5
VOICE_OTEL_ENABLED=false
# Optional exporter URL; blank prints spans locally when enabled.
VOICE_OTEL_ENDPOINT=

# M2: offline runs the real graph with a scripted planner and local tools, no text-model cost.
# Set openai to enable natural-language delegation (uses OPENAI_API_KEY, billed separately).
VOICE_WORKER_MODE=offline
VOICE_WORKER_MODEL=gpt-4.1-mini
VOICE_WORKER_MAX_STEPS=4
VOICE_DELEGATION_TIMEOUT_SECONDS=15
VOICE_DELEGATION_RESULT_TOKENS=120

# M3: optional one-shot fallback; server-only credentials
VOICE_FALLBACK_ENABLED=false
VOICE_AZURE_ENDPOINT=
VOICE_AZURE_API_KEY=
VOICE_AZURE_DEPLOYMENT=gpt-realtime
VOICE_AZURE_VOICE=marin

# M4: optional metrics export; enable VOICE_OTEL_ENABLED as well
VOICE_OTEL_METRICS_ENDPOINT=

# M5: public demo requires HTTPS, production mode and personal invitation tokens.
# Supply JSON mapping stable pseudonymous IDs to randomly generated tokens (>=32 chars).
VOICE_PUBLIC_DEMO=false
VOICE_INVITE_TOKENS={}
VOICE_DEMO_ENABLED=true
VOICE_QUOTA_DATABASE=.local/quotas.sqlite3
VOICE_DAILY_SESSIONS_PER_USER=4
VOICE_CONCURRENT_SESSIONS_PER_USER=1
VOICE_DAILY_VOICE_SECONDS_PER_USER=1500
VOICE_DAILY_VOICE_SECONDS_GLOBAL=6000
VOICE_MAX_DELEGATIONS_PER_SESSION=8

# M7: primary provider; language/style are chosen before each conversation
VOICE_VOICE_PROVIDER=live
VOICE_REALTIME_MODEL=gpt-realtime

# M8: optional same-host multi-process reference (see deployment/scaling)
VOICE_INSTANCE_ID=
VOICE_WORKER_EXECUTION=local
VOICE_WORKER_SERVICE_URL=http://worker:8001
VOICE_WORKER_SERVICE_TOKEN=
VOICE_WORKER_SERVICE_CAPACITY=4
VOICE_WORKER_MAX_RECORDS=128

# M9 feedback: enabled only with invitations/access code; shared local volume for multiple APIs
VOICE_FEEDBACK_DATABASE=.local/feedback.sqlite3

# Optional offline-dataset Braintrust uploads; never used by live application requests
BRAINTRUST_API_KEY=
