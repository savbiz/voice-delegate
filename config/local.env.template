# Optional platform credentials. Personal-key sessions do not need these.
OPENAI_API_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
VOICE_ELEVENLABS_AGENT_ID=
VOICE_ELEVENLABS_WEBHOOK_TOKEN=
VOICE_ELEVENLABS_WEBHOOK_URL=

# Default voice integration. Users can select any configured integration in the UI.
VOICE_ADAPTER=live

# local runs the worker in this API; remote uses the private HTTP service below.
VOICE_WORKER_EXECUTION=local
# Only needed for remote; give the worker service the same token.
# VOICE_WORKER_SERVICE_URL=http://127.0.0.1:8001
# VOICE_WORKER_SERVICE_TOKEN=

# Local browser origin; Railway needs your exact hosted HTTPS frontend origin instead.
VOICE_ALLOWED_ORIGINS=["http://localhost:5173"]
# Production also needs explicit hostnames, proxy policy, and the platform invitation map.
# See docs/configuration.md and deployment/README.md.
