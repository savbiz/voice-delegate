# https://editorconfig.org - the conventions the repository already follows.
# scripts/check_editorconfig.py enforces the whitespace rules in CI and in the pre-commit hooks.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,toml}]
indent_size = 4
# Matches line-length in [tool.ruff] and printWidth in frontend/.prettierrc.json.
max_line_length = 100

[*.{ts,tsx,js,mjs,json,yml,yaml,css,html}]
max_line_length = 100

[Makefile]
indent_style = tab

# Generated by the native tooling or by scripts; do not reformat by hand.
[frontend/{android,ios}/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset

[{uv.lock,frontend/pnpm-lock.yaml,THIRD_PARTY_NOTICES.md,LICENSE*,backend/src/voice_delegate/limits/data/*}]
trim_trailing_whitespace = unset
insert_final_newline = unset
